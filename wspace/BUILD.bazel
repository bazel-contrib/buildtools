load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wspace",
    srcs = ["workspace.go"],
    importpath = "github.com/bazel-contrib/buildtools/v10/wspace",
    visibility = ["//visibility:public"],
    deps = ["//build"],
