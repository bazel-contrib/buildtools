load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = [
        "config.go",
        "validation.go",
    ],
    importpath = "github.com/bazel-contrib/buildtools/v10/buildifier/config",
    visibility = ["//buildifier:__pkg__"],
    deps = [
        "//tables",
        "//warn",
        "//wspace",
    ],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":config"],
)

alias(
    name = "go_default_library",
    actual = ":config",
    visibility = ["//visibility:public"],
)
